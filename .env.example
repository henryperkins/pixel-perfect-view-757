# Existing chart processor. Configure secrets in the server runtime.
SWISS_EPHEMERIS_URL=
SWISS_EPHEMERIS_KEY=
# Disabled until the native service and its source identity are qualified.
# Full HTTPS endpoint, e.g. https://your-chart-service.example/v1/transit-episodes
SWISS_TRANSIT_EPISODE_URL=
# Reviewed source identity from docs/reviews/daily-transit-story/source-qualification.md
SWISS_TRANSIT_EPISODE_SOURCE_ID=

# Member-writing secret: use ignored .env.local locally and Lovable Cloud secrets when hosted.
# Never put this value in the tracked .env file.
GEMINI_ENTERPRISE_API_KEY=
