                      "key": {
                        "type": "string"
                      },
                      "sign": {
                        "type": "string"
                      },
                      "house": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 12
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "retrograde": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "key",
                      "sign",
                      "house",
                      "retrograde"
                    ],
                    "additionalProperties": false
                  }
                },
                "risingSign": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "chapters": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "key",
                      "title"
                    ],
                    "additionalProperties": false
                  }
                },
                "notices": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "status",
                "houseSystem",
                "placements",
                "risingSign",
                "chapters",
                "notices"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      {
