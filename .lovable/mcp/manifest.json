  "mcp": {
    "server": {
      "name": "pattern",
      "version": "1.0.0",
      "title": "Pattern"
    },
    "tools": [
      {
        "name": "get_today",
        "title": "Today's saved reading",
        "description": "Read today's saved chart-only reading and timing. Never generates a reading. UTC unless a supplied timezone is permitted by the member's device-timezone setting.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "timezone": {
              "default": "UTC",
              "type": "string",
              "maxLength": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "unavailable"
                },
                "reason": {
                  "type": "string"
                },
                "notices": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "status",
                "reason",
                "notices"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "available"
                },
                "day": {
                  "type": "string"
                },
                "timezone": {
                  "type": "string"
                },
                "windows": {
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "transit": {
                        "type": "string"
                      },
                      "natal": {
                        "type": "string"
                      },
                      "aspect": {
                        "type": "string"
                      },
                      "phase": {
                        "type": "string"
                      },
                      "startsOn": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "exactOn": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "endsOn": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "key",
                      "transit",
                      "natal",
                      "aspect",
                      "phase",
                      "startsOn",
                      "exactOn",
                      "endsOn"
                    ],
                    "additionalProperties": false
                  }
                },
                "notices": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "reading": {
                  "type": "object",
                  "properties": {
                    "headline": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "body": {
                      "type": "string",
                      "maxLength": 40000
                    },
                    "prompt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high"
                      ]
                    }
                  },
                  "required": [
                    "headline",
                    "body",
                    "prompt",
                    "confidence"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "status",
                "day",
                "timezone",
                "windows",
                "notices",
                "reading"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      {
        "name": "get_pattern",
        "title": "Your saved pattern",
        "description": "Saved chart placements, rising sign when reliable, and chapter list. Excludes raw birth details and coordinates.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
