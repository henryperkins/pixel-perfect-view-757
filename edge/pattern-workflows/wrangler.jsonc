// Mirrors the deployed pattern-workflows bindings; PATTERN_WORKFLOW_SECRET stays a
// Worker secret and is never stored here.
{
  "name": "pattern-workflows",
  "main": "worker.mjs",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "PATTERN_APP_URL": "https://patterns.lakefrontdigital.io" },
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    {
      "binding": "RECORDS",
      "database_name": "pattern-records",
      "database_id": "9054f856-4e28-48c0-8f6f-d02f479466fb",
    },
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "pattern-artifacts" }],
  "workflows": [
    { "name": "context-retention", "binding": "RETENTION", "class_name": "RetentionWorkflow" },
    { "name": "nightly-reading", "binding": "NIGHTLY", "class_name": "NightlyReadingWorkflow" },
    {
      "name": "synthetic-evaluation",
      "binding": "EVALUATIONS",
      "class_name": "SyntheticEvaluationWorkflow",
    },
  ],
}
