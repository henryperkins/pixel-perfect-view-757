 await page.getByRole('link',{name:'Check-in',exact:true}).click();
 const mood=page.getByRole('radio',{name:'Mood: 3 of 5, Steady'});
 await click(mood.locator('..'));
 const note=page.getByLabel('Reflection note · optional');
 await note.fill(reflection);
 await page.getByText('Draft saved on this device',{exact:true}).waitFor();
 results.push({step:'Enter check-in',mood:await mood.isChecked(),note:await note.inputValue()});
 await click(page.getByRole('button',{name:'Save check-in',exact:true}));
 await page.locator('.today-check-in-save').getByRole('status').filter({hasText:/^Saved /}).waitFor();
 results.push({step:'Save check-in',confirmed:true});
 await page.getByRole('navigation',{name:'Quick navigation'}).getByRole('link',{name:'Journal',exact:true}).click();
