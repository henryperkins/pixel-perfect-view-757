 await page.getByRole('heading',{name:'Leave room for an unhurried answer'}).waitFor();
 await page.evaluate(()=>document.fonts.ready);
 results.push({step:'Read Today',visible:await page.getByRole('heading',{name:'Leave room for an unhurried answer'}).isVisible()});
