 results.push({step:'Navigate to Journal',confirmed:true});
 await page.getByRole('navigation',{name:'Quick navigation'}).getByRole('link',{name:'Today',exact:true}).click();
 await note.waitFor();
 await page.reload();
 await note.waitFor();
 results.push({step:'Return to Today and reload',reflectionRetained:await note.inputValue()===reflection});
 return {engine,version:page.context().browser().version(),viewport:page.viewportSize(),evidence:'Render with synthetic services',results};
}
)(page);
