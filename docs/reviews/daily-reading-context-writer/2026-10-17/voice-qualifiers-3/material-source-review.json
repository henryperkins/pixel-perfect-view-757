  "genericPrinciples": [
    {
      "id": "visible-first",
      "status": "pass",
      "assessment": "Supported detail or plain distinction is a general editing move; it imports no object, setting or astrology claim."
    },
    {
      "id": "consequence-once",
      "status": "pass",
      "assessment": "Cuts a redundant abstraction after one concrete consequence without authorizing a new consequence."
    },
    {
      "id": "claim-local-qualifiers",
      "status": "pass",
      "assessment": "Retains each condition and modal on its claim; permits only an immediate clear hypothetical reference and does not borrow an unrelated modal."
    },
    {
      "id": "finish-on-the-choice",
      "status": "pass",
      "assessment": "Requires support and an optional small choice; it adds no counselor script or promised resolution."
    },
    {
      "id": "no-strengthening",
      "status": "pass",
      "assessment": "Explicitly prevents new speed/ease/frequency/necessity when shortening. This does not erase source-supported I2 ease."
    }
  ],
